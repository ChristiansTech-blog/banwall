#!/usr/bin/env bash
# Stub für 'dpkg-query'. Protokolliert den Aufruf und verhält sich so, wie es
# der Testfall über STUB_<KOMMANDO>_RC / _OUT vorgibt.
printf '%s %s\n' "dpkg-query" "$*" >>"${STUB_LOG:-/dev/null}"
_var="STUB_DPKG_QUERY_OUT"
[[ -n "${!_var:-}" ]] && printf '%s\n' "${!_var}"
_rc="STUB_DPKG_QUERY_RC"
exit "${!_rc:-0}"

#!/usr/bin/env bash
# Stub für 'ssh-keygen'. Protokolliert den Aufruf und verhält sich so, wie es
# der Testfall über STUB_<KOMMANDO>_RC / _OUT vorgibt.
printf '%s %s\n' "ssh-keygen" "$*" >>"${STUB_LOG:-/dev/null}"
_var="STUB_SSH_KEYGEN_OUT"
[[ -n "${!_var:-}" ]] && printf '%s\n' "${!_var}"
_rc="STUB_SSH_KEYGEN_RC"
exit "${!_rc:-0}"

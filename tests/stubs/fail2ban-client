#!/usr/bin/env bash
# Stub für 'fail2ban-client'. Protokolliert den Aufruf und verhält sich so, wie es
# der Testfall über STUB_<KOMMANDO>_RC / _OUT vorgibt.
printf '%s %s\n' "fail2ban-client" "$*" >>"${STUB_LOG:-/dev/null}"
_var="STUB_FAIL2BAN_CLIENT_OUT"
[[ -n "${!_var:-}" ]] && printf '%s\n' "${!_var}"
_rc="STUB_FAIL2BAN_CLIENT_RC"
exit "${!_rc:-0}"

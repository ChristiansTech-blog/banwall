#!/usr/bin/env bash
# Stub für 'systemctl'. Protokolliert den Aufruf und verhält sich so, wie es
# der Testfall über STUB_<KOMMANDO>_RC / _OUT vorgibt.
printf '%s %s\n' "systemctl" "$*" >>"${STUB_LOG:-/dev/null}"
_var="STUB_SYSTEMCTL_OUT"
[[ -n "${!_var:-}" ]] && printf '%s\n' "${!_var}"
_rc="STUB_SYSTEMCTL_RC"
exit "${!_rc:-0}"
